# Python-generated files
__pycache__/
*.py[cod]
*$py.class
build/
dist/
wheels/
*.egg-info/

# Virtual environments
.venv/

# Tests, coverage, and tooling
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.pyright/
.ruff_cache/
.tox/
.nox/

# Notebooks
.ipynb_checkpoints/
/notebooks/

