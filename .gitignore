.env
.env.*
!.env.example

# Local data and generated model artifacts
/artifacts/**
!/artifacts/**/
/checkpoints/**
!/checkpoints/**/
!/checkpoints/.gitkeep
/runs/**
!/runs/**/

# Editors and operating systems
.idea/
.vscode/
/tmp/
.DS_Store
Thumbs.db

# Package markers in project folders
!__init__.py

# Keep only the data directory placeholder
/data/*
!/data/.gitkeep
